# Login privado del portal. No usar NEXT_PUBLIC para credenciales.
WHOLESALE_USER=cliente
WHOLESALE_PASSWORD=cambiar-esta-clave
AUTH_COOKIE_NAME=soloimportado_auth

# Opción A: Google Sheet privado con Service Account
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Productos!A:Z
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opción B: CSV publicado de Google Sheets. Si esto existe, se usa antes que la Service Account.
SHEET_CSV_URL=
